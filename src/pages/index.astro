4 203.901C52.8932 214.518 39.126 225.979 27.41 240.269C24.1841 244.206 21.0722 248.324 18.1629 252.675C13.0116 260.38 8.41158 268.817 5.10598 278.073C-0.0400915 292.553 -1.99391 309.086 2.5391 325.48C4.90079 333.925 9.01723 342.259 15.434 349.366C21.8722 356.462 30.3967 362.036 40.5257 364.429C46.8699 365.918 53.2737 365.96 59.2186 365.02C65.2765 364.06 70.9165 362.126 76.1185 359.502C86.3293 354.319 94.1433 347.012 100.579 339.761C124.733 312.154 135.549 279.04 146.198 248.411C153.593 226.934 161.162 205.504 169.141 184.204C175.871 166.235 183.275 148.494 190.485 130.625C197.942 112.128 205.417 92.9531 209.462 72.2544C209.903 69.9881 210.309 67.6652 210.648 65.2817C211.769 57.3642 212.055 48.6158 210.248 39.6362C209.458 35.7235 208.275 31.813 206.607 27.9952C205.788 26.1209 204.848 24.2724 203.777 22.4744C201.184 17.6441 195.355 11.3399 190.552 8.44503C179.241 1.41169 169.063 0.41495 158.76 0.0112782C156.935 -0.0199432 155.117 0.0141153 153.307 0.108987C147.939 0.407597 142.509 0.996294 137.171 1.8624C128.949 3.18966 120.938 5.13994 113.091 7.37389C112.584 7.5184 112.074 7.66556 111.56 7.81543C93.1704 13.159 76.3177 21.6508 60.433 30.4119Z" fill="currentColor"/>
        </svg>
        <h1 class="hero-name font-serif font-normal tracking-wide mb-2">Jakob Jann</h1>
        <p class="hero-sub leading-relaxed text-brand-parchment/90">
          Restaurierung von<br />Streichinstrumenten
        </p>
      </div>
    </section>
  </div>

  <!-- ── Page content ── -->
  <div class="page-wrap relative z-10 text-brand-stroke rounded-[2rem] pt-16 lg:pt-32">

    <!-- Note box -->
    <!--
    <div class="max-w-3xl mx-auto px-4 sm:px-6 mb-10">
      <div class="bg-brand-box border-[3px] border-brand-stroke rounded-[20px] px-6 py-5 text-brand-stroke">
        <div class="flex items-center gap-2 mb-2">
          <span aria-hidden="true">☀️</span>
          <strong class="font-bold text-[1.0625rem]">Urlaub</strong>
        </div>
        <p class="text-[1.0625rem] leading-[1.75]">
          Vom 23.05.2027 bis 23.06.2027 ist meine Werkstatt geschlossen.
          Per E-Mail bin ich weiterhin für Sie erreichbar. Einen schönen Sommer!
        </p>
      </div>
    </div>
    -->

    <!-- Heading – wider column -->
    <div class="max-w-3xl lg:max-w-4xl mx-auto px-4 sm:px-6 mb-5">
      <h2 class="main-heading font-serif font-normal leading-[1.15] tracking-tight">
        Verantwortung für Klang, Substanz und Geschichte.
      </h2>
    </div>

    <!-- Biography -->
    <div class="max-w-3xl lg:max-w-4xl mx-auto px-4 sm:px-6 mb-12">

<p class="text-[1.0625rem] leading-[1.75] text-justify hyphens-auto">
        Jakob Jann wuchs in Oberbayern auf und fand früh zur Arbeit mit Holz und Klang.
        Fundament seiner breiten Ausbildung sind Studiengang und Meisterkurs. Seit 2010
        arbeitete er in verschiedenen Ateliers in Deutschland, Frankreich und Österreich,
        ehe er sich 2025 auf die Restaurierung von Streichinstrumenten in Wien
        selbstständig machte.
      </p>

      <div id="bio-expandable" aria-hidden="true">
        <p class="text-[1.0625rem] leading-[1.75] text-justify hyphens-auto pt-4">
          Seither hat er eine Vielzahl historischer Instrumente restauriert – darunter
          Violinen des 17. und 18. Jahrhunderts sowie seltene Violen und Celli aus
          bedeutenden europäischen Werkstätten. Sein besonderes Interesse gilt der
          Klangforschung: Wie verändern Materialien, Lacke und Konstruktionsweise den
          Ton eines Instruments über Jahrhunderte? Diese Fragen leiten ihn bei jeder
          Restaurierung und verbinden handwerkliche Präzision mit wissenschaftlicher
          Neugier.
        </p>
      </div>

      <div style="clear: both;"></div>

      <button
        id="read-more-btn"
        class="mt-3 p-0 bg-transparent border-0 text-[1.0625rem] text-brand-stroke/60
               underline underline-offset-[3px] cursor-pointer
               hover:text-brand-stroke transition-colors"
        aria-expanded="false"
        aria-controls="bio-expandable"
      >Weiterlesen</button>
    </div>

    <!-- Photo collage -->
    <PhotoCollage
      images={[
        { src: `${import.meta.env.BASE_URL}images/collage/portrait1.jpg`, alt: 'Porträt', priority: true },
        { src: `${import.meta.env.BASE_URL}images/collage/sample1.jpg`,  alt: 'Werkstattbild' },
        { src: `${import.meta.env.BASE_URL}images/collage/smaple2.jpg`,  alt: 'Werkstattbild' },
      ]}
    />

    <!-- Contact section -->
    <div id="kontakt" class="max-w-3xl mx-auto px-4 sm:px-6 pb-12">

      <!-- Button row -->
      <div class="btn-row flex flex-wrap gap-3 items-start">

        <div id="email-wrapper">
          <button
            id="copy-email-btn"
            class="bg-transparent text-brand-stroke border-[3px] border-brand-stroke
                   rounded-[20px] px-5 py-2.5 text-[1.0625rem] font-normal
                   cursor-pointer hover:bg-brand hover:text-brand-parchment hover:border-brand transition-colors"
          >E-Mail-Adresse kopieren</button>
        </div>

        <a
          href="tel:+43XXXXXXXXX"
          class="bg-transparent text-brand-stroke border-[3px] border-brand-stroke
                 rounded-[20px] px-5 py-2.5 text-[1.0625rem] font-normal
                 no-underline hover:bg-brand hover:text-brand-parchment hover:border-brand transition-colors"
        >Direkt anrufen</a>

        <button
          id="share-btn"
          class="bg-transparent text-brand-stroke border-[3px] border-brand-stroke
                 rounded-[20px] px-5 py-2.5 text-[1.0625rem] font-normal
                 cursor-pointer hover:bg-brand hover:text-brand-parchment hover:border-brand transition-colors"
        >Seite teilen</button>

        <a
          href="https://www.instagram.com/"
          target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-transparent text-brand-stroke border-[3px] border-brand-stroke
                 rounded-[20px] px-5 py-2.5 text-[1.0625rem] font-normal
                 no-underline hover:bg-brand hover:text-brand-parchment hover:border-brand transition-colors"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[1em] h-[1em] shrink-0" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
          Instagram
        </a>

      </div>

      <!-- Tooltip row (shared by all buttons above that carry a tooltip) -->
      <p
        id="email-tooltip"
        role="tooltip"
        class="tooltip-row text-[1.0625rem] leading-snug text-brand-stroke/60"
      >…und im E-Mail-Programm wieder einfügen.</p>
    </div>

  </div>

  <!-- Footer -->
  <footer class="bg-brand">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
      <a href={`${import.meta.env.BASE_URL}impressum`} class="text-brand-parchment/70 text-sm underline underline-offset-2 hover:text-brand-parchment transition-colors">Impressum</a>
    </div>
  </footer>

  <script>
    const btn        = document.getElementById('read-more-btn');
    const expandable = document.getElementById('bio-expandable');
    let open = false;

    btn.addEventListener('click', () => {
      open = !open;

      if (open) {
        // Measure content height, animate to it, then release to 'auto'
        expandable.style.height = expandable.scrollHeight + 'px';
        expandable.addEventListener('transitionend', () => {
          expandable.style.height = 'auto';
        }, { once: true });
      } else {
        // Pin to current pixel height first (needed if height was 'auto')
        expandable.style.height = expandable.offsetHeight + 'px';
        // Two rAFs: first commits the pinned height, second starts the transition
        requestAnimationFrame(() => requestAnimationFrame(() => {
          expandable.style.height = '0px';
        }));
      }

      expandable.setAttribute('aria-hidden', String(!open));
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Weniger lesen' : 'Weiterlesen';
    });
  </script>

  <script>
    const EMAIL = 'kontakt@jakobjann.at'; // ← update to real address

    const emailBtn     = document.getElementById('copy-email-btn');
    const emailWrapper = document.getElementById('email-wrapper');
    const tooltip      = document.getElementById('email-tooltip');
    const shareBtn     = document.getElementById('share-btn');

    const canHover = window.matchMedia('(hover: hover)').matches;
    let tooltipVisible = false;

    // ── Tooltip: show on hover (desktop) ────────────────
    if (canHover) {
      emailBtn.addEventListener('mouseenter', () => tooltip.classList.add('shown'));
      emailBtn.addEventListener('mouseleave', () => tooltip.classList.remove('shown'));
    }

    // ── Copy email ───────────────────────────────────────
    async function copyEmail() {
      try {
        await navigator.clipboard.writeText(EMAIL);
      } catch {
        // execCommand fallback for older browsers
        const ta = Object.assign(document.createElement('textarea'), { value: EMAIL });
        ta.style.cssText = 'position:fixed;opacity:0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      tooltip.classList.remove('shown');
      tooltipVisible = false;
      const orig = emailBtn.textContent;
      emailBtn.textContent = 'Adresse kopiert ✓';
      setTimeout(() => { emailBtn.textContent = orig; }, 2500);
    }

    emailBtn.addEventListener('click', () => {
      if (!canHover && !tooltipVisible) {
        // Mobile first tap: show tooltip
        tooltip.classList.add('shown');
        tooltipVisible = true;
      } else {
        // Desktop click or mobile second tap: copy
        copyEmail();
      }
    });

    // Close tooltip when tapping elsewhere on mobile
    document.addEventListener('click', (e) => {
      if (tooltipVisible && !emailWrapper.contains(e.target)) {
        tooltip.classList.remove('shown');
        tooltipVisible = false;
      }
    });

    // ── Share page ───────────────────────────────────────
    const isMobile = window.matchMedia('(hover: none), (pointer: coarse)').matches;

    shareBtn.addEventListener('click', async () => {
      if (isMobile && navigator.share) {
        try {
          await navigator.share({
            title: 'Jakob Jann – Restaurierung von Streichinstrumenten',
            url: location.href,
          });
        } catch { /* user cancelled */ }
      } else {
        await navigator.clipboard.writeText(location.href);
        const orig = shareBtn.textContent;
        shareBtn.textContent = 'Link kopiert ✓';
        setTimeout(() => { shareBtn.textContent = orig; }, 2500);
      }
    });
  </script>

  <script>
    const tab     = document.querySelector('.kontakt-tab');
    const section = document.getElementById('kontakt');
    if (tab && section) {
      new IntersectionObserver(([entry]) => {
        tab.style.opacity       = entry.isIntersecting ? '0' : '';
        tab.style.pointerEvents = entry.isIntersecting ? 'none' : '';
      }).observe(section);
    }
  </script>

</body>
</html>
