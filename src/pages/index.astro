---
import PhotoCollage from '../components/PhotoCollage.astro';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jakob Jann – Restaurierung von Streichinstrumenten</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet" />
  <style is:global>
    /* Things Tailwind can't express */
    html { scroll-behavior: smooth; }
    body { overflow-x: clip; }

    :root { --scroll-stop: 82vh; }

    .hero-zone {
      height: calc(200vh  - var(--scroll-stop));
      height: calc(200dvh - var(--scroll-stop));
    }
    .page-wrap {
      margin-top: calc(var(--scroll-stop) - 100vh);
      margin-top: calc(var(--scroll-stop) - 100dvh);
    }

    /* Vertical text on Kontakt tab – desktop only */
    @media (min-width: 1024px) {
      .kontakt-tab { writing-mode: vertical-rl; }
    }

    /* Fluid type */
    .hero-name    { font-size: clamp(2.75rem, 10vw,  5.5rem); }
    .hero-sub     { font-size: clamp(1rem,    2.5vw, 1.375rem); }
    .main-heading { font-size: clamp(2rem,    5.5vw, 3.25rem); }

    /* Read-more: animate between exact pixel heights — always smooth */
    #bio-expandable {
      overflow: hidden;
      height: 0;
      transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Parchment section floats over hero */
    .page-wrap { @apply bg-brand-parchment; box-shadow: 0 -8px 28px rgba(0, 0, 0, 0.18); }

    /* Tooltip row: full-width in-flow block between button rows.
       Animates from zero height to content height on both mobile and desktop.
       Place a .tooltip-row after any .btn-row that contains buttons with tooltips. */
    .tooltip-row {
      overflow: hidden;
      max-height: 0;
      margin-top: 0;
      opacity: 0;
      transition: max-height 0.4s ease, margin-top 0.3s ease, opacity 0.25s ease;
      pointer-events: none;
    }
    .tooltip-row.shown {
      max-height: 10rem;
      margin-top: 0.5rem;
      opacity: 1;
    }

  </style>
</head>
<body class="bg-brand text-brand-parchment font-sans">

  <!-- Noise filter: baseFrequency matches Figma size 0.5/0.5 -->
  <svg class="hidden" aria-hidden="true">
    <defs>
      <filter id="noise-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.5 0.5" numOctaves="4" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
    </defs>
  </svg>

  <!--
    Noise overlay:
    - brand-stroke at 29% opacity
    - mix-blend-mode: overlay → dark on light (white text gets grain),
      screen-like on dark bg (warm highlights on orange)
  -->
  <div
    class="fixed inset-0 pointer-events-none z-[9999] opacity-[0.29] mix-blend-overlay bg-brand-stroke"
    style="filter: url('#noise-filter');"
    aria-hidden="true"
  ></div>

  <!-- Kontakt tab -->
  <a
    href="#kontakt"
    class="kontakt-tab fixed bottom-0 right-4 z-[100]
           lg:bottom-auto lg:right-auto lg:left-0 lg:top-1/2 lg:-translate-y-1/2
           bg-brand-box text-brand-stroke text-[1.0625rem] font-normal no-underline
           py-3 px-5 rounded-t-[12px] border-[3px] border-b-0 border-brand-stroke
           lg:py-5 lg:px-3 lg:rounded-tl-none lg:rounded-bl-none lg:rounded-tr-[12px] lg:rounded-br-[12px] lg:border-b-[3px] lg:border-l-0
           hover:opacity-80 transition-opacity"
  >Kontakt</a>

  <!-- ── Hero ── -->
  <div class="hero-zone">
    <section class="sticky top-0 h-screen flex items-center justify-center p-8">
      <div class="flex flex-col items-center text-center">
        <svg
          role="img" aria-label="Logo Jakob Jann"
          viewBox="0 0 301 479" fill="none" xmlns="http://www.w3.org/2000/svg"
          class="w-auto mb-9"
          style="height: clamp(160px, 28vh, 260px);"
        >
          <path d="M60.433 30.4119C59.2787 31.0384 58.4071 32.1259 57.9945 33.4033C57.5829 34.6827 57.664 36.0472 58.2354 37.2287C58.8068 38.4102 59.8262 39.321 61.0847 39.7925C62.3423 40.2622 63.7359 40.2542 64.9437 39.7382C64.9437 39.7382 64.9437 39.7382 64.9437 39.7382C81.583 32.4577 98.0917 25.8222 115.123 22.7666C115.611 22.6778 116.095 22.5921 116.575 22.5092C124.017 21.2225 131.482 20.5666 138.884 20.457C143.702 20.3831 148.474 20.5463 153.307 20.8517C154.696 20.9466 156.076 21.0779 157.445 21.2444C164.935 22.1019 173.118 24.6613 176.789 27.74C179.754 30.1768 180.353 31.0716 182.156 34.5762C182.596 35.4789 182.989 36.4302 183.332 37.4244C184.031 39.4481 184.505 41.6551 184.768 43.9533C185.384 49.2546 184.887 55.1254 183.977 61.4926C183.706 63.4042 183.387 65.3595 183.039 67.3584C179.849 85.6962 174.851 104.324 169.301 123.265C163.952 141.543 158.258 159.757 151.567 177.621C143.634 198.798 134.841 219.671 125.786 240.468C112.933 270.122 99.1264 298.976 78.7785 319.486C73.3851 324.95 67.8852 329.334 62.449 331.904C59.7917 333.169 57.0148 334.045 54.4038 334.454C51.829 334.861 49.4444 334.815 47.3646 334.381C44.0699 333.719 40.4143 331.719 37.499 328.786C34.531 325.83 32.0406 321.713 30.4228 317.029C27.2583 308.008 27.4087 296.936 30.4566 286.37C32.4114 279.543 35.5252 272.782 39.4534 266.235C41.6684 262.541 44.1198 258.899 46.7482 255.307C55.8609 242.822 67.5951 231.606 80.2927 220.972C84.0361 217.834 87.8527 214.718 91.7097 211.587C106.67 199.284 121.984 188.569 138.788 178.632C142.397 176.466 146.064 174.358 149.757 172.33C167.852 162.459 187.945 155.42 206.745 152.5C216.707 151.051 226.37 151.479 234.776 153.683C235.575 153.892 236.369 154.118 237.157 154.362C244.538 156.649 251.423 160.3 256.439 165.54C262.708 171.957 266.795 182.679 267.039 194.004C267.193 200.03 266.387 206.288 264.803 212.522C263.379 218.136 261.544 223.789 259.54 229.52C248.097 262.276 232.75 293.778 217.31 325.559C201.37 358.408 185.584 390.794 165.651 419.438C158.677 429.537 151.495 4